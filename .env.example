# Copy to .env.local for local overrides. Vercel sets deployed values per environment
# in the project settings; nothing here is read in production.

# Each environment variable the app reads is documented here.

# Signs the anonymous session cookie. At least 32 characters; generate one with
# `openssl rand -base64 32`. Set it per Vercel environment. Changing it orphans every
# anonymous player's progress, so rotate it only deliberately.
SESSION_SECRET=

# Optional, local only. Playwright's downloaded browsers do not run on NixOS, so point
# end-to-end tests at a system Chromium instead. CI leaves it unset.
# PLAYWRIGHT_CHROMIUM_EXECUTABLE=/run/current-system/sw/bin/chromium
